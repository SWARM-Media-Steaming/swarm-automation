(function (root, factory) {
  const api = factory();
  if (typeof module === "object" && module.exports) module.exports = api;
  if (root) root.SwarmUsageCost = api;
})(typeof window === "undefined" ? globalThis : window, () => {
  "use strict";

  // Pure helpers for the Feedback view's Usage & cost panel (issue #295).
  // Everything here is formatting and filter-state arithmetic — the numbers
  // themselves are aggregated in SQLite and arrive already summed, because
  // the panel must never pull the usage table into the desktop to add it up.
  //
  // The one rule every formatter below shares: a value the provider never
  // reported renders as UNAVAILABLE, never as 0. "We don't know" and "it was
  // zero" are different facts, and collapsing them is how a usage report
  // starts lying about coverage.
  const UNAVAILABLE = "—";

  // Group-by dimensions the selector lists, in that order. The query API
  // also accepts `outcome` (success vs. failure); that is a grouping the
  // CLI and other callers use, not a Feedback dropdown option.
  const USAGE_GROUPS = [
    { value: "issue", label: "Issue" },
    { value: "model", label: "Model" },
    { value: "provider", label: "Provider" },
    { value: "grade", label: "Prompt grade" },
    { value: "effort", label: "Reasoning effort" },
    { value: "agent", label: "Agent type" },
    { value: "prompt", label: "Prompt type" },
    { value: "repository", label: "Repository" },
    { value: "day", label: "Day" },
    { value: "week", label: "Week" },
    { value: "month", label: "Month" },
  ];

  function groupLabel(key) {
    const found = USAGE_GROUPS.find((entry) => entry.value === key);
    return found ? found.label : USAGE_GROUPS[0].label;
  }

  function normalizeGroupBy(value) {
    const next = String(value || "");
    return USAGE_GROUPS.some((entry) => entry.value === next) ? next : USAGE_GROUPS[0].value;
  }

  // The aggregate table. `sort` is the key the backend orders by; a column
  // without one is not sortable. `numeric` right-aligns and formats as a
  // token count unless the column says otherwise.
  const GROUP_COLUMNS = [
    { key: "group", label: "Group", sort: "group", numeric: false },
    { key: "issues", label: "Issues", sort: "issues", numeric: true, plain: true },
    { key: "invocations", label: "Invocations", sort: "invocations", numeric: true, plain: true },
    { key: "inputTokens", label: "Input", sort: "input", numeric: true },
    { key: "cachedTokens", label: "Cached", sort: "cached", numeric: true },
    { key: "reasoningTokens", label: "Reasoning", sort: "reasoning", numeric: true },
    { key: "outputTokens", label: "Output", sort: "output", numeric: true },
    { key: "totalTokens", label: "Total", sort: "total", numeric: true },
    { key: "estimatedCost", label: "Estimated cost", sort: "cost", numeric: true, cost: true },
    { key: "cacheHitEfficiency", label: "Cache hit efficiency", numeric: true },
    { key: "sessionReused", label: "Sessions reused", numeric: true },
    { key: "cacheSavingsEstimate", label: "API-equivalent cache savings", numeric: true, cost: true },
    { key: "coverage", label: "Coverage", sort: "", numeric: false },
  ];

  const INVOCATION_COLUMNS = [
    { key: "agentType", label: "Agent" },
    { key: "providerModel", label: "Provider / Model" },
    { key: "promptType", label: "Prompt" },
    { key: "reasoningEffort", label: "Effort" },
    { key: "attemptNumber", label: "Attempt", numeric: true, plain: true },
    { key: "inputTokens", label: "Input", numeric: true },
    { key: "cacheReadTokens", label: "Cache read", numeric: true },
    { key: "cacheWriteTokens", label: "Cache write", numeric: true },
    { key: "cachedInputTokens", label: "Cached", numeric: true },
    { key: "reasoningTokens", label: "Reasoning", numeric: true },
    { key: "outputTokens", label: "Output", numeric: true },
    { key: "totalTokens", label: "Total", numeric: true },
    { key: "estimatedCost", label: "Estimated cost", numeric: true, cost: true },
    { key: "reportedCost", label: "Reported cost", numeric: true, cost: true },
    { key: "cacheSavingsEstimate", label: "API-equivalent cache savings", numeric: true, cost: true },
    { key: "sessionId", label: "Session" },
    { key: "sessionReused", label: "Session reused", numeric: true, plain: true },
    { key: "durationMs", label: "Duration", numeric: true },
    { key: "result", label: "Result" },
  ];

  // Reporting coverage. Each status answers a different question about why a
  // row does or does not carry money, and they map onto the app's existing
  // .suite-state palette rather than introducing new status colors.
  const COVERAGE = [
    {
      key: "complete",
      label: "Complete",
      tone: "passed",
      help: "Provider token totals were recorded and a matching price was available.",
    },
    {
      key: "tokens_only",
      label: "Tokens only",
      tone: "running",
      help: "Authoritative usage exists, but no price covers that model — unpriced, not free.",
    },
    {
      key: "partial",
      label: "Partial",
      tone: "blocked",
      help: "The invocation was recorded, but one or more expected usage fields were not supplied.",
    },
    {
      key: "unreported",
      label: "Unreported",
      tone: "",
      help: "An invocation happened, but the provider returned no authoritative usage at all.",
    },
    {
      key: "failed",
      label: "Failed",
      tone: "failed",
      help: "The invocation failed. Any usage the provider still returned is shown.",
    },
  ];

  function coverageTone(status) {
    const entry = COVERAGE.find((item) => item.key === status);
    return entry ? entry.tone : "";
  }

  function coverageLabel(status) {
    const entry = COVERAGE.find((item) => item.key === status);
    return entry ? entry.label : String(status || "");
  }

  // Coverage counts as chips, statuses with no rows dropped so a clean set
  // of invocations does not read as four kinds of problem at zero each.
  function coverageChips(counts) {
    const source = counts && typeof counts === "object" ? counts : {};
    return COVERAGE.map((entry) => ({
      ...entry,
      count: Number(source[entry.key]) || 0,
    })).filter((entry) => entry.count > 0);
  }

  // The dominant coverage status of a group — what its single Coverage cell
  // shows. Worst-first, because a group that is 90% complete and 10% failed
  // should not read as simply "Complete".
  function dominantCoverage(counts) {
    const source = counts && typeof counts === "object" ? counts : {};
    const order = ["failed", "unreported", "partial", "tokens_only", "complete"];
    for (const key of order) {
      if ((Number(source[key]) || 0) > 0) return key;
    }
    return "";
  }

  function isMissing(value) {
    return value === null || value === undefined || value === "";
  }

  function formatTokens(value) {
    if (isMissing(value)) return UNAVAILABLE;
    const number = Number(value);
    return Number.isFinite(number) ? number.toLocaleString() : UNAVAILABLE;
  }

  function formatEfficiency(value) {
    return typeof value === "number" && Number.isFinite(value) && value >= 0 && value <= 1
      ? `${(value * 100).toFixed(1)}%` : UNAVAILABLE;
  }

  function formatCount(value) {
    const number = Number(value);
    return Number.isFinite(number) ? number.toLocaleString() : "0";
  }

  // Money is always shown with its currency and always labelled elsewhere as
  // an *estimate*. Sub-cent amounts keep four decimals so a cheap routing
  // call does not render as $0.00 and look free.
  function formatCost(value, currency = "USD") {
    if (isMissing(value)) return UNAVAILABLE;
    const number = Number(value);
    if (!Number.isFinite(number)) return UNAVAILABLE;
    const symbol = currency === "USD" ? "$" : `${currency} `;
    const sign = number < 0 ? "-" : "";
    const magnitude = Math.abs(number);
    if (magnitude !== 0 && magnitude < 0.01) return `${sign}${symbol}${magnitude.toFixed(4)}`;
    return `${sign}${symbol}${magnitude.toLocaleString(undefined, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    })}`;
  }

  function formatDurationMs(value) {
    if (isMissing(value)) return UNAVAILABLE;
    const ms = Number(value);
    if (!Number.isFinite(ms) || ms < 0) return UNAVAILABLE;
    if (ms < 1000) return `${Math.round(ms)} ms`;
    const seconds = ms / 1000;
    if (seconds < 60) return `${seconds.toFixed(1)}s`;
    const minutes = Math.floor(seconds / 60);
    return `${minutes}m ${Math.round(seconds % 60)}s`;
  }

  // "2 of 5 priced" — shown next to every estimated-cost aggregate so a
  // total is never read as covering more invocations than it does.
  function pricedLabel(priced, invocations) {
    const total = Number(invocations) || 0;
    const covered = Number(priced) || 0;
    if (!total) return "No invocations";
    return `${formatCount(covered)} of ${formatCount(total)} priced`;
  }

  // Sorting is server-side; this only decides what to ask for next. Clicking
  // the active column flips direction, a new column starts descending
  // (largest first) except the group label, which starts ascending.
  function nextSort(current, direction, column) {
    const next = String(column || "");
    if (!GROUP_COLUMNS.some((entry) => entry.sort === next && next)) {
      return { sort: String(current || "cost"), direction: String(direction || "desc") };
    }
    if (current === next) {
      return { sort: next, direction: direction === "asc" ? "desc" : "asc" };
    }
    return { sort: next, direction: next === "group" ? "asc" : "desc" };
  }

  const FILTER_KEYS = [
    "startDate",
    "endDate",
    "issueNumber",
    "grade",
    "provider",
    "model",
    "effort",
    "agentType",
    "promptType",
    "outcome",
    "coverage",
    "executionId",
    "search",
  ];

  function defaultFilters() {
    const filters = {};
    FILTER_KEYS.forEach((key) => {
      filters[key] = "";
    });
    filters.outcome = "all";
    return filters;
  }

  // "all" is the outcome filter's neutral value, so it does not count as an
  // active filter — otherwise "Clear filters" would always look available.
  function hasActiveFilters(filters) {
    const source = filters || {};
    return FILTER_KEYS.some((key) => {
      const value = String(source[key] ?? "");
      if (key === "outcome") return value !== "" && value !== "all";
      return value !== "";
    });
  }

  function normalizeFilters(filters) {
    const source = filters || {};
    const next = defaultFilters();
    FILTER_KEYS.forEach((key) => {
      if (source[key] !== undefined && source[key] !== null) next[key] = String(source[key]);
    });
    next.outcome = ["all", "success", "failure"].includes(next.outcome) ? next.outcome : "all";
    return next;
  }

  // The three empty states the panel must tell apart (issue #295):
  // no telemetry has ever been recorded here, activity exists but none of it
  // reported usage, and the current filters simply match nothing.
  function emptyStateMessage({ hasAnyUsage, hasAnyActivity, filtered } = {}) {
    if (!hasAnyUsage && !hasAnyActivity) {
      return "No AI activity recorded yet. Run an issue and it appears here.";
    }
    if (!hasAnyUsage) {
      return "Usage unavailable for these repositories. Per-invocation telemetry is recorded for runs made locally after #280 — imported and older executions have no usage to show, and GitHub comments are never scraped to fill them in.";
    }
    if (filtered) return "No usage matches these filters.";
    return "No usage recorded for this selection.";
  }

  // The label an aggregate row shows in its Group cell. Grouping by issue
  // yields a repo-qualified number plus the issue's title; every other
  // dimension is its own value, with an explicit stand-in when the value was
  // never recorded so a blank row is never just blank.
  function groupRowLabel(row, groupBy) {
    const record = row || {};
    const value = String(record.group ?? "");
    if (groupBy === "issue") {
      const title = String(record.issueTitle || "").trim();
      return title ? `${value} · ${title}` : value || "Issue not recorded";
    }
    if (value) return value;
    return {
      model: "Model not recorded",
      provider: "Provider not recorded",
      grade: "Not graded",
      effort: "Effort not recorded",
      agent: "Agent not recorded",
      prompt: "Prompt type not recorded",
      repository: "Repository not recorded",
    }[groupBy] || "Not recorded";
  }

  // "Showing 1-10 of 42" for either table, or an empty string when one page
  // holds everything and a pager would be noise.
  function pagerLabel(offset, shown, total) {
    const count = Number(total) || 0;
    const start = (Number(offset) || 0) + 1;
    const end = (Number(offset) || 0) + (Number(shown) || 0);
    if (!count) return "";
    if (end - start + 1 >= count) return `${formatCount(count)} total`;
    return `Showing ${formatCount(start)}-${formatCount(end)} of ${formatCount(count)}`;
  }

  // Cross-link payloads. Prompt Grades, Router Activity and Execution
  // History all open the same view with the same filter shape rather than
  // each inventing a private query.
  function filtersForIssue(issueNumber, grade = "") {
    return { ...defaultFilters(), issueNumber: String(issueNumber || ""), grade: String(grade || "") };
  }

  function filtersForRouterSelection(provider, model = "") {
    return {
      ...defaultFilters(),
      provider: String(provider || ""),
      model: String(model || ""),
      agentType: "router",
    };
  }

  function filtersForExecution(executionId) {
    return { ...defaultFilters(), executionId: String(executionId || "") };
  }

  return {
    UNAVAILABLE,
    USAGE_GROUPS,
    GROUP_COLUMNS,
    INVOCATION_COLUMNS,
    COVERAGE,
    FILTER_KEYS,
    groupLabel,
    normalizeGroupBy,
    coverageTone,
    coverageLabel,
    coverageChips,
    dominantCoverage,
    formatTokens,
    formatCount,
    formatEfficiency,
    formatCost,
    formatDurationMs,
    pricedLabel,
    nextSort,
    defaultFilters,
    hasActiveFilters,
    normalizeFilters,
    emptyStateMessage,
    groupRowLabel,
    pagerLabel,
    filtersForIssue,
    filtersForRouterSelection,
    filtersForExecution,
  };
});
