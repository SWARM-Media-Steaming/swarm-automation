# Settings for the local stack (docker compose up, repository root).
#   cp web/.env.example .env
# .env is git-ignored. Never commit real values, and never paste them in an issue.

# --- GitHub App (create one at https://github.com/settings/apps/new) ---------
# Callback URL:  http://localhost:8080/api/v1/auth/github/callback
# Webhook URL:   a public tunnel to http://localhost:8080/api/v1/webhooks/github
#                (webhooks need a reachable URL; sign-in does not)
# Permissions:   Contents, Issues, Pull requests, Statuses (read & write), Metadata (read)
# Events:        Issues, Issue comment, Pull request, Installation
SWARM_WEB_GITHUB_CLIENT_ID=
SWARM_WEB_GITHUB_CLIENT_SECRET=
SWARM_WEB_GITHUB_WEBHOOK_SECRET=
SWARM_WEB_GITHUB_APP_ID=
SWARM_WEB_GITHUB_APP_SLUG=
# The App's private key on one line, a literal \n for each line break:
#   awk 'NF {printf "%s\\n", $0}' app-private-key.pem
SWARM_WEB_GITHUB_APP_PRIVATE_KEY=

# --- Key that seals each tenant's provider API keys (development) -----------
# Generate one:   openssl rand -base64 32
SWARM_WEB_LOCAL_KEY=

# --- Optional ---------------------------------------------------------------
# Origin the browser uses (must match the GitHub App's callback origin).
# SWARM_WEB_PUBLIC_URL=http://localhost:8080
# Bearer token (24+ characters) for the operator /internal API.
# SWARM_WEB_INTERNAL_TOKEN=
# GitHub logins whose comments may steer a job, comma separated.
# SWARM_WEB_TRUSTED_AUTHORS=
# The local stack keeps identity, tenants and sessions in its Postgres
# (SWARM_WEB_STORE=postgres, set by docker-compose.yml); `cargo run` without it
# uses the in-memory store, which loses everything on restart.
# Linux: the group that owns /var/run/docker.sock.
# DOCKER_GID=
# Acceptance runs without provider CLIs (a fixture worker delivers a commit):
# SWARM_WORKER_DOCKERFILE=web/worker/Dockerfile.fixture
# SWARM_WORKER_IMAGE=swarm-automation-worker:fixture
