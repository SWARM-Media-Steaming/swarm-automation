# cp terraform.tfvars.example terraform.tfvars   (git-ignored)
region           = "us-east-1"
name_prefix      = "swarm"
domain_name      = "swarm.example.com"
certificate_arn  = "arn:aws:acm:us-east-1:111122223333:certificate/00000000-0000-0000-0000-000000000000"
api_image        = "111122223333.dkr.ecr.us-east-1.amazonaws.com/swarm/api:0.1.0"
worker_image     = "111122223333.dkr.ecr.us-east-1.amazonaws.com/swarm/worker:0.1.0"
github_app_id    = 123456
github_client_id = "Iv1.0000000000000000"
github_app_slug  = "swarm-automation"
trusted_authors  = ["your-github-login"]

# Keep 0 until the secrets are populated, then set 1 and apply again.
api_desired_count = 0
