{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWARM Automation",
  "version": "0.1.0",
  "identifier": "app.swarm.automation",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SWARM Automation",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Run AI issue workers and closed-loop UAT checks from a native desktop control center.",
    "createUpdaterArtifacts": true,
    "resources": {
      "issue_worker/*.py": "issue_worker/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/SWARM-Media-Steaming/swarm-automation/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBRTJFRDAzQ0NBMkYxOEIKUldTTDhhTE1BKzNpNnJhelZJbWJxMEdJZ2VVL2tjQkZ1UVFudmVqcEQ0eThjNHQrTVd3bmlBQTgK",
      "windows": { "installMode": "passive" }
    }
  }
}
